# Spatius (server-only key; do NOT prefix with NEXT_PUBLIC_)
SPATIUS_API_KEY=replace_me
SPATIUS_APP_ID=app_muw7fjet_12b3dkj
SPATIUS_AVATAR_ID=9078fde3-8e55-4311-a8d6-7740185b5b0d
SPATIUS_REGION=auto
SPATIUS_SESSION_TTL_MINUTES=55
# Optional override. When blank, auto uses us-west only for token minting.
# SPATIUS_CONSOLE_ENDPOINT=https://console.us-west.spatius.ai/v1/console

# Gemini (server-only; used only to mint short-lived Live API tokens)
GEMINI_API_KEY=replace_me
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Kore

# TikTok live feed (optional; when blank the comment feed is disabled and
# only the autopilot director runs). TIKTOK_SESSION_ID is the optional
# `sessionid` cookie value for a more reliable connection.
TIKTOK_USERNAME=
# TIKTOK_SESSION_ID=
